# ==================== Docker Compose 环境变量 ====================
# 复制此文件为 .env 并填入真实值

# JWT 密钥（必填，生产环境请使用强随机字符串）
# 生成命令：node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# ⚠️ 请勿使用示例值，务必生成独立随机密钥
JWT_SECRET=your_jwt_secret_change_in_production

# CORS 允许的前端地址
CORS_ORIGIN=http://localhost:3000

# 交易手续费率（0.5%）
FEE_RATE=0.005

# -------------------- 平台钱包（必填） --------------------
PLATFORM_WALLET_ADDRESS=0x_YOUR_PLATFORM_WALLET_ADDRESS
PLATFORM_WALLET_PRIVATE_KEY=your_private_key_here

# -------------------- Polymarket API 凭证 --------------------
PLATFORM_POLY_API_KEY=
PLATFORM_POLY_API_SECRET=
PLATFORM_POLY_PASSPHRASE=

# -------------------- 钱包签名配置 --------------------
# 0=EOA (默认), 3=POLY_1271 (存款钱包)
PLATFORM_SIGNATURE_TYPE=0
PLATFORM_FUNDER_ADDRESS=

# -------------------- 收费模式 --------------------
# spread=价差模式, subscription=订阅模式
PLATFORM_FEE_MODE=spread
MIN_WITHDRAW_AMOUNT=10
