# ============================================================
# PrediX 环境变量模板
# 复制为 .env 并填入真实值
# ============================================================

# ---- 服务器 ----
PORT=3001

# ============================================================
# 数据库 (PostgreSQL)
# 本地开发: postgresql://用户:密码@localhost:5432/数据库名
# Docker:    postgresql://用户:密码@postgres:5432/数据库名
# 云数据库:  postgresql://用户:密码@云服务地址:5432/数据库名
# ============================================================
DATABASE_URL=postgresql://predix:你的数据库密码@localhost:5432/predix_db

# ---- JWT 密钥 (生成方式: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))") ----
JWT_SECRET=在此填入生成的64字节随机密钥

# ============================================================
# Polymarket API（默认值通常不需要修改）
# ============================================================
POLYMARKET_GAMMA_API=https://gamma-api.polymarket.com
POLYMARKET_CLOB_API=https://clob.polymarket.com
POLYMARKET_DATA_API=https://data-api.polymarket.com
POLYMARKET_WS=wss://ws-subscriptions-clob.polymarket.com/ws/market

# ---- 手续费率（0.005 = 0.5%） ----
FEE_RATE=0.005

# ---- CORS 允许的前端地址 ----
# 本地: http://localhost:3000
# Vercel: https://predix.apay.eu.cc
# Render 自动域名: https://predix-backend.onrender.com
CORS_ORIGIN=http://localhost:3000

# ============================================================
# 平台钱包（Polymarket 代理钱包）
# ⚠️ 生产环境务必更换为正式钱包地址和私钥
# ============================================================
PLATFORM_WALLET_ADDRESS=你的平台钱包地址
PLATFORM_WALLET_PRIVATE_KEY=你的平台钱包私钥

# ---- Polymarket API 密钥（用于签名 CLOB 请求） ----
PLATFORM_POLY_API_KEY=你的Polymarket_API_Key
PLATFORM_POLY_API_SECRET=你的Polymarket_API_Secret
PLATFORM_POLY_PASSPHRASE=你的Polymarket_API_Passphrase

# ---- 签名类型: 0=EOA (默认), 3=POLY_1271 (存款钱包) ----
PLATFORM_SIGNATURE_TYPE=0

# ---- POLY_1271 模式下的存款钱包地址 (仅 SIGNATURE_TYPE=3 时需要) ----
PLATFORM_FUNDER_ADDRESS=

# ---- 平台收费模式: spread（价差模式）或 subscription（订阅模式） ----
PLATFORM_FEE_MODE=spread

# ---- Relayer API Key（Gas 代付） ----
RELAYER_API_KEY=
RELAYER_API_KEY_ADDRESS=

# ---- 最低提现金额（USDC） ----
MIN_WITHDRAW_AMOUNT=10

# ============================================================
# 备份
# ============================================================
BACKUP_DIR=/app/backups
BACKUP_RETENTION_DAYS=30
BACKUP_MAX_COUNT=50
